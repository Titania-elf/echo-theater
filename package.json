{
    "name": "titania-theater",
    "version": "5.4.0",
    "description": "沉浸式角色内心独白与平行世界演绎插件",
    "type": "module",
    "scripts": {
        "test": "node --experimental-vm-modules --test --test-isolation=none tests/illustration.test.mjs tests/cleaning.test.mjs tests/tempInstruction.test.mjs tests/pacing.test.mjs tests/textRewrite.test.mjs",
        "test:illustration": "node --experimental-vm-modules --test --test-isolation=none tests/illustration.test.mjs",
        "test:cleaning": "node --experimental-vm-modules --test --test-isolation=none tests/cleaning.test.mjs",
        "test:temp": "node --experimental-vm-modules --test --test-isolation=none tests/tempInstruction.test.mjs",
        "test:pacing": "node --experimental-vm-modules --test --test-isolation=none tests/pacing.test.mjs",
        "build": "node build.js",
        "build:watch": "node build.js --watch",
        "prebuild": "node scripts/css-audit.js",
        "css:audit": "node scripts/css-audit.js",
        "css:audit:strict": "node scripts/css-audit.js --strict",
        "css:audit:compare": "node scripts/css-audit.js --compare",
        "css:audit:baseline": "node scripts/css-audit.js --update-baseline",
        "css:color-diff": "git diff --no-ext-diff --unified=100000 -- css/04-features/outline-entry-menu.css css/04-features/cleaning-preview.css css/04-features/st-embedded.css | node scripts/css-color-diff.js"
    },
    "devDependencies": {
        "esbuild": "^0.24.0",
        "jsdom": "^29.1.1"
    },
    "keywords": [
        "sillytavern",
        "extension",
        "roleplay"
    ],
    "author": "Titania",
    "license": "MIT"
}
